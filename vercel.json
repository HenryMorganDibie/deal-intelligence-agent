{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "bash deploy/vercel-ignore-api.sh",
  "functions": {
    "api/index.py": {
      "maxDuration": 180,
      "includeFiles": "{src/**,docs/*.json,docs/backtest_predictions.csv,docs/automation/learned_ranker.json,evaluation/**/*.jsonl,evaluation/**/results*.json,evaluation/review/**}",
      "excludeFiles": "{web/**,evaluation/review/*/pool.jsonl}"
    },
    "api/market_snapshot.py": {
      "maxDuration": 300,
      "regions": [
        "cdg1"
      ],
      "includeFiles": "{src/**,docs/*.json,docs/backtest_predictions.csv,docs/automation/learned_ranker.json,evaluation/**/*.jsonl,evaluation/**/results*.json,evaluation/review/**}",
      "excludeFiles": "{web/**,evaluation/review/*/pool.jsonl}"
    }
  },
  "rewrites": [
    {
      "source": "/api/cron/market-snapshot",
      "destination": "/api/market_snapshot"
    },
    {
      "source": "/api/cron/market-intraday",
      "destination": "/api/market_snapshot"
    },
    {
      "source": "/api/cron/market-instruments",
      "destination": "/api/market_snapshot"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/market-snapshot",
      "schedule": "23 17 * * 1-5"
    }
  ]
}
