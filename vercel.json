{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "exit 1",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "{src/**,docs/*.json,docs/backtest_predictions.csv,docs/automation/learned_ranker.json,evaluation/**/*.jsonl,evaluation/**/results*.json,evaluation/review/**}",
      "excludeFiles": "{web/**,evaluation/review/*/pool.jsonl}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/label",
      "schedule": "17 6 * * *"
    },
    {
      "path": "/api/cron/ingest",
      "schedule": "41 5 * * *"
    },
    {
      "path": "/api/cron/showcase",
      "schedule": "53 6 * * *"
    }
  ]
}