{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "{src/**,docs/backtest_summary.json,docs/evaluation_report.json,docs/backtest_predictions.csv,docs/return_forecast_validation.json,docs/automation/learned_ranker.json,evaluation/**/*.json,evaluation/**/*.jsonl}",
      "excludeFiles": "web/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/label",
      "schedule": "17 6 * * *"
    },
    {
      "path": "/api/cron/ingest",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/showcase",
      "schedule": "53 6 * * *"
    }
  ]
}
