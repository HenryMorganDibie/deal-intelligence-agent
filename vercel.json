{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "{src/**,docs/backtest_summary.json}",
      "excludeFiles": "web/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/label",
      "schedule": "17 6 * * *"
    },
    {
      "path": "/api/cron/ingest",
      "schedule": "41 5 * * *"
    }
  ]
}
