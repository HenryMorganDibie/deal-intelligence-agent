 "rules": [
  {
   "name": "Walk-forward replay",
   "rule": "On each monthly as-of date the engine sees only sources published in the previous 30 days. A signal type that was already flagged for the company within the previous 90 days is not a new prediction."
  },
  {
   "name": "Event confirmation (confirmable types)",
   "rule": "Confirmed if, strictly after the as-of date and within 90 calendar days, an SEC filing (8-K item codes, Forms 4/13D, 15-12B, 25), an NGX or NSE Kenya disclosure, or a credible news report records the event type for the same company. Refuted if none appears. 'Official only' counts filings and exchange disclosures and excludes news."
  },
  {
   "name": "Market reaction (all types)",
   "rule": "Stock close on the first trading day on or after as-of + 10 calendar days, against the first close on or after the as-of date, minus the benchmark's return over the same dates (S&P 500 for US, Satrix 40 for JSE, NGX ASI, NSE NASI). About 7 trading days. Missing prices leave the move unlabelled."
  },
  {
   "name": "Price-only types",
   "rule": "Earnings surprises and insider trades are themselves the disclosure, so they are not 'confirmed'; they are judged only on whether the market-adjusted move went the expected way (source-stated direction when available, else the type's hypothesised sign)."
  },
  {
   "name": "Base rate",
   "rule": "Share of all company-months (each company on each as-of date) followed within 90 days by a confirmed event of that type, whether or not anything was flagged. Lift = precision / base rate."
  },
  {
   "name": "Recall",
   "rule": "Share of confirmed events that a prediction of the same type preceded by 1 to 90 days."
  },
  {
   "name": "Hosted (live) labelling",
   "rule": "Hosted briefs are labelled with the same rules: price reaction once a brief is 12 days old (so the day-10 close exists even across a weekend or holiday), confirmation once it is 95 days old (the 90-day window plus 5 days for filings and reports to be indexed)."
  },
  {
   "name": "Intervals",
   "rule": "95% Wilson score intervals for proportions; lift intervals divide the precision interval by the base rate (base-rate uncertainty not included); means use a normal approximation (mean \u00b1 1.96\u00b7sd/\u221an)."
  }
 ]
}